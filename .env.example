# ---- Servidor ----
PORT=3000
# URL pública HTTPS del app (Railway o túnel). SIN slash final.
# Ej: https://poc-agente-bitrix24-production.up.railway.app
BASE_URL=

# ---- Anthropic (BYOK) ----
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_CLASSIFIER=claude-haiku-4-5

# ---- Bot ----
BOT_CODE=poc_agente_postgrados

# ---- Bitrix OAuth (renovación del access_token) ----
# Del registro de la app local en el portal (ID y Clave de la aplicación).
BITRIX_CLIENT_ID=
BITRIX_CLIENT_SECRET=
# Token de aplicación que Bitrix envía en cada evento/instalación (verifica el origen de los webhooks).
# Se captura solo en la instalación (se persiste), pero fijarlo aquí cierra la validación por completo.
BITRIX_APPLICATION_TOKEN=

# ---- Endurecimiento (Seguridad) ----
# Con NODE_ENV=production se activa el "fail-closed": los secretos pasan a ser OBLIGATORIOS.
NODE_ENV=
# Secreto del servidor de voz (Vapi): protege /vapi/events y /voice/outbound.
VAPI_SECRET=
# Token para los paneles embebidos y sus APIs (/app, /calls, /metrics/summary, /calls/data, /stats, /debug/config).
# El placement propaga este token en la URL (?k=). Tras definirlo, re-enlaza: /setup/bind-dashboard y /setup/bind-calls.
DASHBOARD_TOKEN=
# Token para las utilidades administrativas (/setup/*).
ADMIN_TOKEN=
# Rate limiting por IP (peticiones/minuto): global y estricto (eventos del bot + llamadas salientes).
RATE_LIMIT_MAX=600
RATE_LIMIT_STRICT=240
# Allowlist de orígenes (Origin/Referer) permitidos para POST /webchat/message, además del propio
# BASE_URL (se incluye automáticamente). Lista separada por comas, ej: https://postgrados.uautonoma.cl
# Vacío = sin restricción (solo rate-limit + tope de mensajes por conversación).
WEBCHAT_ALLOWED_ORIGINS=
# Cliente Anthropic: timeout por request (ms) y reintentos.
ANTHROPIC_TIMEOUT_MS=45000
ANTHROPIC_MAX_RETRIES=2
# Tamaño del pool de Postgres.
PGPOOL_MAX=10
# Cifrado de tokens OAuth en reposo (AES-256-GCM). 32 bytes en hex (64 caracteres). Genera: openssl rand -hex 32
# Si se deja vacío, los tokens se guardan en claro (los ya guardados se migran solos al definirla).
TOKEN_ENC_KEY=
# Backpressure: máximo de turnos del bot procesados en paralelo por instancia.
MAX_CONCURRENT_TURNS=8
# Retención de auditoría: borra audit_log más antiguo que N días (0 = desactivado).
AUDIT_RETENTION_DAYS=0
# Redacción de PII en logs y auditoría (email/teléfono). off para desactivar (solo debug local).
LOG_REDACT=on

# ---- Opcional: smoke REST sin OAuth ----
# Webhook entrante de Bitrix24 (Aplicaciones > Webhooks > Webhook entrante).
# Solo para `npm run smoke:bitrix` rápido; el bot en sí usa OAuth.
# Ej: https://tu-portal.bitrix24.cl/rest/1/abcdef123456
BITRIX_WEBHOOK_URL=

# ---- Persistencia / Observabilidad (opcionales; si faltan, se usa memoria/no-op) ----
# En Railway: agrega los plugins "Redis" y "Postgres" → definen REDIS_URL y DATABASE_URL solos.
REDIS_URL=
DATABASE_URL=
# Postgres externo (no el interno de Railway) suele requerir SSL:
PGSSL=false

# ---- Lead Scoring (opcional) ----
# Si creas campos personalizados en el CRM para guardar el scoring, pon aquí sus códigos
# (ej. UF_CRM_1700000000). Si los dejas vacíos, el scoring solo queda como nota en el timeline.
BITRIX_UF_SCORE=
BITRIX_UF_INTENT=
BITRIX_UF_SENTIMENT=
# Campo UF (Deal) con el "Programa de interés" que el bot mantiene al día según la conversación.
BITRIX_UF_PROGRAMA=
# Campo UF tipo "Archivo" (Deal) con el brochure (PDF real del Drive) del programa de interés —
# se actualiza junto al de arriba, buscando en las carpetas BITRIX_DRIVE_FOLDER_* el PDF que mejor
# calza con el nombre del programa. Lo adjunta el Proceso de Negocio de BITRIX_BIZPROC_TEMPLATE_BROCHURE.
# Si la persona muestra interés en VARIOS programas durante la conversación, cada uno va en un
# archivo SEPARADO (slots UF_BROCHURE_FILE_2, _3, ...); si se acumulan más programas que slots
# configurados, los que sobran se fusionan (mismo PDF) en el ÚLTIMO slot disponible.
BITRIX_UF_BROCHURE_FILE=
BITRIX_UF_BROCHURE_FILE_2=
BITRIX_UF_BROCHURE_FILE_3=
# Campo UF tipo "String" (Deal) con el cuerpo EN TEXTO PLANO del correo del brochure, ya renderizado
# por el bot (saludo + lista de programas acumulados + datos de contacto del asesor) — la plantilla
# bizproc solo lo referencia vía {=Document:...}. Es texto plano (no HTML) porque Bitrix24 escapa el
# HTML de los valores de campos Document al resolver el placeholder, y porque los emoji truncan esta
# columna (ver crm/brochureEmail.ts para el detalle).
BITRIX_UF_CUERPO_BROCHURE_HTML=
# IDs de las carpetas del Drive de Bitrix24 ("Brochures Bot/<tipo>") con los PDF de cada tipo de
# programa (ver disk.storage.getlist / disk.folder.getchildren para obtenerlos).
BITRIX_DRIVE_FOLDER_MAGISTER=
BITRIX_DRIVE_FOLDER_DIPLOMADO=
BITRIX_DRIVE_FOLDER_ESPECIALIDAD=
# ID de la plantilla de Proceso de Negocio (bizproc, importada en Bitrix24) que envía el correo
# con el brochure adjunto — el bot la dispara vía bizproc.workflow.start apenas adjunta un
# brochure nuevo (no depende de etapas ni de una Automation Rule).
BITRIX_BIZPROC_TEMPLATE_BROCHURE=

# Mover la etapa del deal según el score, por embudo (multi-flujo). Mapa JSON categoryId -> {alto,medio}.
# Ej (C1=Diplomados, C3=Magísteres):
# {"1":{"alto":"C1:PREPARATION","medio":"C1:UC_JARL1O"},"3":{"alto":"C3:PREPAYMENT_INVOICE","medio":"C3:PREPARATION"}}
BITRIX_STAGE_MAP=
# (Legacy, un solo embudo; usa BITRIX_STAGE_MAP en su lugar):
BITRIX_STAGE_SCORE_ALTO=
BITRIX_STAGE_SCORE_MEDIO=
# Auto-escalar a un asesor si el score alcanza este umbral (0 = desactivado):
SCORE_ESCALAR=80

# ---- M4: Instagram / Messenger (Meta Graph API) ----
# Suscribe el webhook en developers.facebook.com → tu app → Messenger/Instagram → Webhooks.
# Handshake GET (hub.verify_token): cualquier string que definas aquí y repitas al suscribir.
META_VERIFY_TOKEN=
# App Secret de la app de Meta (Configuración básica): firma cada POST (X-Hub-Signature-256).
META_APP_SECRET=
# Page Access Token (scopes: pages_messaging, instagram_basic, instagram_manage_messages).
# Se usa para responder por la Send API, tanto a Messenger como a Instagram (Página vinculada).
META_PAGE_ACCESS_TOKEN=

# ---- Campaña de voz SALIENTE — Magíster en Marketing Digital (Fase 0) ----
# UFs del Deal que crea `scripts/bitrix-create-campaign-fields.ts` (pon aquí el código UF_CRM_... real
# que imprime el script). El SCORE reutiliza BITRIX_UF_SCORE de arriba.
BITRIX_UF_CLASIFICACION=
BITRIX_UF_PRIORIDAD=
BITRIX_UF_PROX_SEGUIMIENTO=
BITRIX_UF_INTENTOS=
# Activa la campaña MMD (false = desactivada; el scheduler no la recorre). Arranca en false por seguridad.
CAMPAIGN_MMD_ACTIVO=false
# Embudo (CATEGORY_ID) de los deals del Magíster en Marketing Digital.
CAMPAIGN_MMD_CATEGORY_ID=
# Etapas (STAGE_ID) del ciclo de campaña (usa /setup/deal-stages para listarlas).
CAMPAIGN_MMD_STAGE_EN_CAMPANA=
CAMPAIGN_MMD_STAGE_INTERESADO=
CAMPAIGN_MMD_STAGE_NO_INTERESADO=
CAMPAIGN_MMD_STAGE_RECUPERACION=
# Asignación de asesor: round-robin (default) | owner | fixed. Pool = IDs de asesores separados por coma.
CAMPAIGN_MMD_ASESOR_ESTRATEGIA=round-robin
CAMPAIGN_MMD_ASESORES=
CAMPAIGN_MMD_ASESOR_FALLBACK=
# Plantilla oficial de WhatsApp para la recuperación tras 9 intentos (requiere aprobación de Meta).
CAMPAIGN_MMD_WA_TEMPLATE=
CAMPAIGN_MMD_WA_LANG=es
# Agenda de llamadas (comunes a todos los programas; hora de Chile). Los defaults ya son 3x3 = 9 intentos.
CAMPAIGN_TZ=America/Santiago
CAMPAIGN_WAVES=09:15,14:15,18:45
CAMPAIGN_MAX_POR_DIA=3
CAMPAIGN_MAX_DIAS=3
CAMPAIGN_MAX_TOTAL=9
CAMPAIGN_VENTANA_INI=09:00
CAMPAIGN_VENTANA_FIN=19:00
# Días hábiles (dom=0 .. sáb=6) y feriados (YYYY-MM-DD separados por coma) en que NO se llama.
CAMPAIGN_DIAS_HABILES=1,2,3,4,5
CAMPAIGN_FERIADOS=
# Máximo de llamadas simultáneas por ola (tope de concurrencia Vapi/Twilio).
CAMPAIGN_MAX_CONCURRENT=5

# ---- Recuperación por WhatsApp tras 9 intentos (Fase 5) ----
# Proveedor: 'meta' (WhatsApp Cloud API), 'custom' (POST genérico, p.ej. ChatApp), o vacío = desactivado
# (los deals AGOTADO quedan sin WhatsApp, para trabajo manual). La plantilla se define en CAMPAIGN_MMD_WA_TEMPLATE.
WA_PROVIDER=
# Proveedor 'meta' (WhatsApp Cloud API): número emisor y token.
WA_CLOUD_PHONE_NUMBER_ID=
WA_CLOUD_TOKEN=
# Proveedor 'custom' (ChatApp u otro): URL de envío, cabeceras (JSON) y plantilla del body con placeholders
# {{to}} {{template}} {{lang}} {{param0}} {{paramsJson}}.
WA_API_URL=
WA_API_HEADERS={"Content-Type":"application/json"}
WA_API_BODY={"to":"{{to}}","template":"{{template}}","language":"{{lang}}","params":{{paramsJson}}}

